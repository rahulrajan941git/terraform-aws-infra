terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}

provider "aws" {
  region = "us-east-1" # Replace with your target region
}

# Variables for existing network infrastructure
variable "vpc_id" {
  type        = string
  description = "The ID of your existing VPC (e.g., vpc-xxxxxxx)"
}

variable "subnet_id" {
  type        = string
  description = "The ID of an existing public subnet within the VPC (e.g., subnet-xxxxxxx)"
}

# Fetch the latest Amazon Linux 2023 AMI
data "aws_ami" "amazon_linux_2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# Generate a new SSH key pair
resource "tls_private_key" "ec2_ssh_key" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

# Register the public key in AWS
resource "aws_key_pair" "ec2_key_pair" {
  key_name   = "terraform-ec2-keypair"
  public_key = tls_private_key.ec2_ssh_key.public_key_openssh
}

# Save the private key locally for SSH connections
resource "local_file" "private_key" {
  content         = tls_private_key.ec2_ssh_key.private_key_pem
  filename        = "${path.module}/terraform-ec2-keypair.pem"
  file_permission = "0400"
}

# Security Group allowing SSH from 0.0.0.0/0
resource "aws_security_group" "ssh_access" {
  name        = "allow-ssh-all"
  description = "Allow inbound SSH traffic from anywhere"
  vpc_id      = var.vpc_id

  ingress {
    description = "SSH from anywhere"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "allow-ssh-sg"
  }
}

resource "aws_instance" "ec2_vm" {
  ami                         = data.aws_ami.amazon_linux_2023.id
  instance_type               = "t3.small"
  subnet_id                   = var.subnet_id
  key_name                    = aws_key_pair.ec2_key_pair.key_name
  vpc_security_group_ids      = [aws_security_group.ssh_access.id]
  iam_instance_profile        = aws_iam_instance_profile.ssm_instance_profile.name # Added IAM profile
  associate_public_ip_address = true
  lifecycle {
    ignore_changes = [ami, associate_public_ip_address]
  }

  # Root Volume Configuration
  root_block_device {
    volume_size           = 30 # Total size in GB (8 GB default + 20 GB)
    volume_type           = "gp3"
    encrypted             = true
    delete_on_termination = true
  }

  tags = {
    Name = "t3-small-vm"
  }
}


# IAM Role allowing EC2 to assume roles
resource "aws_iam_role" "ssm_role" {
  name = "ec2-ssm-full-access-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole" # Fixed: Added 'sts:' prefix
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })
}

# Attach AWS Managed Policy for SSM Full Access
resource "aws_iam_role_policy_attachment" "ssm_full_access" {
  role       = aws_iam_role.ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMFullAccess"
}

# IAM Instance Profile to attach to the EC2 Instance
resource "aws_iam_instance_profile" "ssm_instance_profile" {
  name = "ec2-ssm-instance-profile"
  role = aws_iam_role.ssm_role.name
}

import {
  to = aws_instance.manual_vm
  id = "i-0d44854f621b396eb" # Replace with your actual Instance ID
}